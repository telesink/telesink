<%= form_with(model: folder, class: "form", data: { turbo: false }) do |form| %>
  <div class="form-field">
    <%= form.label :name, "name", class: "form-field__label" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "text-field" %>
  </div>

  <%= render "shared/banners" %>
  <%= render "shared/form_errors", model: folder %>

  <div>
    <%= form.button "#{folder.persisted? ? "update" : "create" } folder", type: :submit, class: "btn btn--primary" %>
  </div>
<% end %>

<% if folder.persisted? %>
  <div class="divider"></div>

  <details>
    <summary class="link">more</summary>
    <%= button_to(
      "delete folder",
      folder_path(folder),
      method: :delete,
      data: {
        turbo_frame: "_top",
        turbo_confirm: "delete folder '#{@folder.name}' and un-group all sinks inside it?"
      },
      class: "btn btn--danger"
    ) %>
  </details>
<% end %>
