<div class="column__header">
  <h2 class="column__title">
    <% if folder.persisted? %>
      <span class="truncate">edit "<%= folder.name.presence || folder.name_was %>"</span>
    <% else %>
      add a folder
    <% end %>

  </h2>

  <%= link_to(
    "back",
    @back_path,
    data: { turbo_frame: :sinks },
    class: "link"
  ) %>
</div>

<div class="column-data">
  <%= form_with(model: folder, class: "form") do |form| %>
    <div class="form-field">
      <%= form.label :name, "name", class: "form-field__label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "text-field" %>
    </div>

    <%= render "shared/banners" %>
    <%= render "shared/form_errors", model: folder %>

    <div>
      <%= form.button "save folder", type: :submit, class: "btn btn--primary" %>
    </div>
  <% end %>

  <% if folder.persisted? %>
    <div class="divider"></div>

    <details>
      <summary class="link">more</summary>
      <%= button_to(
        "delete folder",
        folder_path(folder),
        method: :delete,
        data: {
          turbo_frame: "_top",
          turbo_confirm: "delete folder '#{@folder.name}' and un-group all sinks inside it?"
        },
        class: "btn btn--danger"
      ) %>
    </details>
  <% end %>
</div>
