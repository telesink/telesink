<%
  title = "sign in"
  content_for(:title, title)
%>

<div class="column">
  <h1 class="column__header"><%= title %></h1>

  <div class="column-data">
    <%= form_with url: session_url, class: "form" do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "email", class: "form-field__label" %>
        <%= form.email_field(
          :email_address,
          required: true,
          autofocus: true,
          autocomplete: "username",
          value: params[:email_address],
          class: "text-field",
        ) %>
      </div>

      <div class="form-field">
        <%= form.label :password, "password", class: "form-field__label" %>
        <%= form.password_field(
          :password,
          required: true,
          autocomplete: "current-password",
          maxlength: 72,
          class: "text-field",
        ) %>
      </div>

      <%= render "shared/banners" %>

      <div>
        <%= form.button "sign in", type: :submit, class: "btn btn--primary" %>
        <%= link_to "forgot password?", new_password_path, class: "link" %>
      </div>

      <div>
        don't have an account? <%= link_to "sign up", new_registration_path, class: "link" %>
      </div>
    <% end %>
  </div>
</div>
