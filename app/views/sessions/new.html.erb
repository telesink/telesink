<%
  title = "sign in"
  content_for(:title, title)
%>
<header>
  <a href="/" class="logo link">
    <%= inline_svg_tag "logo.svg" %>
    telesink
  </a>
</header>

<h1 class="page-title"><%= title %></h1>


<%= form_with url: session_url, class: "form max-w-sm" do |form| %>
  <div class="form-field">
    <%= form.label :email_address, "email", class: "form-field__label" %>
    <%= form.email_field(
      :email_address,
      required: true,
      autofocus: true,
      autocomplete: "username",
      value: params[:email_address],
      class: "text-field",
    ) %>
  </div>

  <div class="form-field">
    <%= form.label :password, "password", class: "form-field__label" %>
    <%= form.password_field(
      :password,
      required: true,
      autocomplete: "current-password",
      maxlength: 72,
      class: "text-field",
    ) %>
  </div>

  <% if alert = flash[:alert] %>
    <div class="banner banner--danger"><%= alert %></div>
  <% end %>

  <% if notice = flash[:notice] %>
    <div class="banner banner--success"><%= notice %></div>
  <% end %>

  <div>
    <%= form.button "sign in", type: :submit, class: "btn btn--primary" %>
    <%= link_to "forgot password?", new_password_path, class: "link" %>
  </div>

  <div>
    don't have an account? <%= link_to "sign up", new_registration_path, class: "link" %>
  </div>
<% end %>

