<%
  title = display_name(@user)
  content_for(:title, title)
%>

<div class="column">
  <div class="column__header">
    <div class="breadcrumbs">
      <h2 class="column__title">
        <%= title %>
      </h2>
    </div>
    <%= link_to settings_members_path, class: "link link--subtle", title: "close", data: { turbo_frame: "_top" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
        <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
      </svg>
    <% end %>
  </div>

  <div class="column-data">
    <p class="column-data__text">
      email:<br>
      <%= mail_to @user.email_address, class: "link" %>
    </p>
  </div>

  <div class="divider"></div>

  <div class="column-data">
    <h2 class="column__title">manage user</h2>
  </div>

  <div class="divider"></div>

  <% if Current.user.admin? || Current.user.owner? %>
    <div class="column-data">
      <ul class="list">
        <% viewing_yourself = @user == Current.user %>

        <% if Current.user.owner? && !viewing_yourself %>
          <li class="list__item list__item--no-padding">
            <%= link_to "change role", edit_settings_member_role_path(@user), class: "link", data: { turbo_frame: "_top" } %>
          </li>
        <% end %>

        <li class="list__item list__item--no-padding">
          <%= link_to "sink access", settings_member_sinks_path(@user), class: "link", data: { turbo_frame: "_top" } %>
        </li>

        <% if Current.user.owner? || Current.user.admin? %>
          <li class="list__item list__item--no-padding">
            <%= link_to "account recovery", settings_member_transfer_path(@user), class: "link", data: { turbo_frame: "_top" } %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
