<%
  column_title = "account recovery"
  title = "#{display_name(@user)}/#{column_title}"
  content_for(:title, title)
%>

<div class="column">
  <div class="column__header">
    <div class="breadcrumbs">
      <%= link_to display_name(@user), settings_member_path(@user), class: "link" %> /
      <h2 class="column__title"><%= column_title %></h2>
    </div>
    <%= link_to settings_members_path, class: "link link--subtle", title: "close", data: { turbo_frame: "_top" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
        <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm2.78-4.22a.75.75 0 0 1-1.06 0L8 9.06l-1.72 1.72a.75.75 0 1 1-1.06-1.06L6.94 8 5.22 6.28a.75.75 0 0 1 1.06-1.06L8 6.94l1.72-1.72a.75.75 0 1 1 1.06 1.06L9.06 8l1.72 1.72a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd" />
      </svg>
    <% end %>
  </div>

  <div class="column-data">
    <p class="column-data__text">
      <% if Current.user == @user %>
        Use this link to quickly log in on another device.
      <% else %>
        Share this link to get them back into their account.
      <% end %>
    </p>

    <p class="column-data__text">
      Notes:
    </p>

    <ul class="list-disc">
      <li class="list-disc__item">Expires in 4 hours</li>
      <li class="list-disc__item">
        <% if Current.user == @user %>
          <strong>Do not share it</strong> with anyone
        <% else %>
          Share <strong>only</strong> with the profile owner
        <% end %>
      </li>
    </ul>

    <div class="form-field">
      <%= label_tag :transfer_link, "sign-in link", class: "form-field__label" %>
      <%= text_field_tag :transfer_link, @transfer_url, class: "text-field", readonly: true, disabled: true %>
    </div>

    <div>
      <%= button_to_copy_to_clipboard(@transfer_url) do %>
        copy link
      <% end %>

      <%= web_share_button(@transfer_url, "Join Telesink", "Join me in Telesink!") do %>
        share link
      <% end %>
    </div>
  </div>
</div>
