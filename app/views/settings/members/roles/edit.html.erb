<%
  title = "role"
  content_for(:title, title)
%>

<div class="column">
  <div class="column__header">
    <div class="breadcrumbs">
      <%= link_to "members", settings_members_path, class: "link" %>/<%= link_to display_name(@user), settings_member_path(@user), class: "link" %>/
      <h2 class="column__title">
        <%= title %>
      </h2>
    </div>

    <%= link_to "close", settings_members_path, class: "link", data: { turbo_frame: "_top" } %>
  </div>

  <div class="column-data">
    <%= render partial: "settings/members/roles/form", user: @user %>
  </div>
</div>
