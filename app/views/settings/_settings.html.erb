<div class="column__header">
  <h1 class="column__title">
    settings
  </h1>

  <%= link_to root_path, class: "link link--subtle", title: "back" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
      <path fill-rule="evenodd" d="M12.5 9.75A2.75 2.75 0 0 0 9.75 7H4.56l2.22 2.22a.75.75 0 1 1-1.06 1.06l-3.5-3.5a.75.75 0 0 1 0-1.06l3.5-3.5a.75.75 0 0 1 1.06 1.06L4.56 5.5h5.19a4.25 4.25 0 0 1 0 8.5h-1a.75.75 0 0 1 0-1.5h1a2.75 2.75 0 0 0 2.75-2.75Z" clip-rule="evenodd" />
    </svg>
  <% end %>
</div>

<nav>
  <h2 class="sidebar__section-title">personal</h2>

  <ul class="list sidebar-list">
    <li class="<%= class_names(
      "sidebar-list__item",
      "sidebar-list__item--current" => current_page?(edit_settings_nickname_path),
    ) %>">
      <%= link_to_unless_current "nickname", edit_settings_nickname_path, class: "link" %>
    </li>

    <li class="<%= class_names(
      "sidebar-list__item",
      "sidebar-list__item--current" => current_page?(edit_settings_email_path),
    ) %>">
      <%= link_to_unless_current "email", edit_settings_email_path, class: "link" %>
    </li>

    <li class="<%= class_names(
      "sidebar-list__item",
      "sidebar-list__item--current" => current_page?(edit_settings_password_path),
    ) %>">
      <%= link_to_unless_current "password", edit_settings_password_path, class: "link" %>
    </li>
  </ul>

  <% if Current.user.admin? || Current.user.owner? %>
    <h2 class="sidebar__section-title">team</h2>

    <ul class="list sidebar-list">
      <li class="<%= class_names(
        "sidebar-list__item",
        "sidebar-list__item--current" => current_page?(settings_invitations_path)
      ) %>">
        <%= link_to_unless_current "invitations", settings_invitations_path, class: "link" %>
      </li>

      <li class="<%= class_names(
        "sidebar-list__item",
        "sidebar-list__item--current" => current_page?(settings_members_path)
      ) %>">
        <%= link_to_unless_current "members", settings_members_path, class: "link" %>
      </li>
    </ul>
  <% end %>
</nav>
