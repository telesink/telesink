<%= form_with(
  model: Current.user,
  url: settings_nickname_path,
  method: :put,
  class: "form",
  data: {
    turbo: false,
  }
) do |form| %>
  <div class="form-field">
    <%= form.label :nickname, "nickname", class: "form-field__label" %>
    <%= form.text_field(
      :nickname,
      required: true,
      autocomplete: "off",
      maxlength: 72,
      class: "text-field",
    ) %>
  </div>

  <%= render "shared/banners" %>

  <div>
    <%= form.button "update nickname", type: :submit, class: "btn btn--primary" %>
  </div>
<% end %>
