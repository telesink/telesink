<%= form_with(
  model: Current.user,
  url: settings_email_path,
  method: :put,
  class: "form",
  data: {
    turbo: false,
  }
) do |form| %>
  <div class="form-field">
    <%= form.label :email_address, "email", class: "form-field__label" %>
    <%= form.email_field(
      :email_address,
      required: true,
      autocomplete: "email",
      class: "text-field",
    ) %>
  </div>

  <%= render "shared/banners" %>

  <div>
    <%= form.button "update email", type: :submit, class: "btn btn--primary" %>
  </div>
<% end %>
