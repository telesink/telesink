<div class="column" data-controller="column" data-column-id-value="<%= column.id %>">
  <%= turbo_frame_tag dom_id(column) do %>
    <%
      last_viewed_at = nil
      if local_assigns[:show_seen_delimiter] && local_assigns[:effective_last_viewed_at]&.present?
        ts = local_assigns[:effective_last_viewed_at][column.id.to_s]
        last_viewed_at = Time.zone.parse(ts) if ts.present?
      end
    %>

    <% events = column.recent_events %>

    <div class="column__header">
      <span class="column__drag-handle">⋮⋮</span>

      <h2 class="column__title">
        <%= column.name %>
      </h2>

      <%= link_to(
        "edit",
        edit_sink_column_path(column.sink, column),
        data: { turbo_frame: dom_id(column) },
        class: "link link--subtle font-normal"
      ) %>
    </div>

    <div
      data-column-target="jumpBar"
      data-action="click->column#jumpToTop"
      class="jump-bar hidden"
    >
      ⇡ back to top
      <span data-column-target="newCount" class="hidden"></span>
    </div>

    <div
      id="events_list_<%= column.id %>"
      class="events-list"
      data-column-target="list"
      data-max-items="200"
      data-controller="events-list unread-delimiter"
      data-unread-delimiter-last-viewed-at-value="<%= last_viewed_at&.iso8601 %>"
    >
      <% events.each do |event| %>
        <%= render "events/preview_card", event: event, column: column %>
      <% end %>
    </div>

    <% if events.size == 30 %>
      <%= turbo_frame_tag(
        "more_#{column.id}",
        src: sink_column_events_path(column.sink, column, before_id: events.last&.id),
        loading: :lazy
      ) do %>
        <div class="events__loading">↓ loading older events&hellip;</div>
      <% end %>
    <% else %>
      <div class="events__end-of-feed">end</div>
    <% end %>

  <% end %>
</div>
