<div class="column">
  <%= turbo_frame_tag dom_id(column) do %>
    <% events = column.recent_events %>

    <div class="column__header">
      <h2 class="column__title">
        <%= column.name %>
      </h2>

      <%= link_to(
        "edit",
        edit_sink_column_path(column.sink, column),
        data: { turbo_frame: dom_id(column) },
        class: "link link--subtle font-normal"
      ) %>
    </div>

    <div id="events_list_<%= column.id %>" class="events-list">
      <% events.each do |event| %>
        <%= render "events/preview_card", event: event, column: column %>
      <% end %>
    </div>

    <% if events.size == 30 %>
      <%= turbo_frame_tag(
        "more_#{column.id}",
        src: sink_column_events_path(column.sink, column, before_id: events.last&.id),
        loading: :lazy
      ) do %>
        <div class="events__loading">
          ↓ loading older events&hellip;
        </div>
      <% end %>
    <% else %>
      <div class="events__end-of-feed"></div>
    <% end %>
  <% end %>
</div>
