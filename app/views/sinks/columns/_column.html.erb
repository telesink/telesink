<% cutoff = local_assigns[:seen_cutoffs]&.[](column.id) %>

<div
  class="column"
  data-controller="column"
  data-column-column-id-value="<%= column.id %>"
  data-column-sink-id-value="<%= column.sink_id %>"
  data-column-cutoff-value="<%= cutoff&.iso8601 %>"
>
  <%= turbo_frame_tag dom_id(column) do %>
    <% events = column.recent_events %>

    <div class="column__header column__header--cast-shadow">
      <span class="column__drag-handle">⋮⋮</span>

      <h2 class="column__title">
        <% if column.search_term %>
          🔎 "<%= column.search_term %>"
        <% else %>
          <%= column.name %>
        <% end %>
      </h2>

      <%= link_to(
        "edit",
        edit_sink_column_path(column.sink, column),
        data: { turbo_frame: dom_id(column) },
        class: "link link--subtle font-normal"
      ) %>
    </div>

    <div
      data-column-target="jumpBar"
      data-action="click->column#jumpToTop"
      class="jump-bar hidden"
      data-turbo-permanent
    >
      ⇡ back to top
      <span data-column-target="newCount" class="hidden"></span>
    </div>

    <div
      id="events_list_<%= column.id %>"
      class="events-list"
      data-column-target="list"
    >
      <% last_date_key = nil %>
      <% delimiter_inserted = false %>
      <% events.each do |event| %>
        <% if cutoff && !delimiter_inserted && event.occurred_at <= cutoff %>
          <div class="seen-delimiter hidden"></div>
          <% delimiter_inserted = true %>
        <% end %>

        <% date_key = event.occurred_at.strftime("%Y-%m-%d") %>
        <% if date_key != last_date_key %>
          <%= render "events/day_delimiter", event: event %>
          <% last_date_key = date_key %>
        <% end %>

        <%= render "events/preview_card", event: event, column: column %>
      <% end %>
    </div>

    <% if events.size == 30 %>
      <%= turbo_frame_tag(
        "more_#{column.id}",
        src: sink_column_events_path(column.sink, column, before_id: events.last&.id),
        loading: :lazy
      ) do %>
        <div class="events__loading loading-dots">↓ loading older events</div>
      <% end %>
    <% else %>
      <div class="events__end-of-feed">end</div>
    <% end %>

  <% end %>
</div>
