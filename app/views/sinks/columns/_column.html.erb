<div class="column">
  <%= turbo_frame_tag dom_id(column),
    data: {
      controller: "column",
      column_column_id_value: column.id,
      column_sink_id_value: column.sink_id,
      column_cutoff_value: local_assigns[:seen_cutoffs]&.[](column.id)&.iso8601
  } do %>
    <% events = column.recent_events %>

    <div class="column__header column__header--cast-shadow">
      <% if Current.user.admin? || Current.user.owner? %>
        <span class="column__drag-handle">⋮⋮</span>
      <% else %>
        <span></span>
      <% end %>

      <h2 class="column__title">
        <% if column.search_term %>
          🔎 "<%= column.search_term %>"
        <% else %>
          <%= column.name %>
        <% end %>
      </h2>

      <% if Current.user.admin? || Current.user.owner? %>
        <%= link_to(
          "edit",
          edit_sink_column_path(column.sink, column),
          data: { turbo_frame: dom_id(column) },
          class: "link link--subtle font-normal"
        ) %>
      <% else %>
        <span></span>
      <% end %>
    </div>

    <div
      data-column-target="jumpBar"
      data-action="click->column#jumpToTop"
      class="jump-bar hidden"
      data-turbo-permanent
    >
      ⇡ back to top
      <span data-column-target="newCount" class="hidden"></span>
    </div>

    <div
      id="events_list_<%= column.id %>"
      class="events-list"
      data-column-target="list"
    >
      <%= render "events/batch", events: events, column: column %>
    </div>

    <%= render "events/more", column: column, events: events %>
  <% end %>
</div>
