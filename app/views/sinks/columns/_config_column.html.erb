<%
  url = "#{request.base_url}#{api_v1_sink_events_path(column.sink.token)}"
%>

<div class="column">
  <%= turbo_frame_tag dom_id(column) do %>
    <div class="column__header column__header--cast-shadow">
      <h1 class="column__title">
        <%= column.name %>
      </h1>
    </div>

    <div class="column-data">
      <p class="column-data__text">
        This column is empty. Make an HTTP POST request to the URL below:
      </p>

      <div class="form-field">
        <%= label_tag :endpoint, "endpoint", class: "form-field__label" %>
        <%= text_field_tag(
          :endpoint,
          url,
          readonly: true,
          class: "text-field",
          onclick: "this.select()"
        ) %>
      </div>

      <%= button_to_copy_to_clipboard(url) { "copy url" } %>

      <hr class="divider">

      <p class="column-data__text">
        To quickly send an event manually, just <a href="https://curl.se/" class="link">curl</a> it like this:
      </p>

      <%
        curl_command = <<~CURL
          curl -X POST #{url} \\
            -H "Content-Type: application/json" \\
            -d '{
              "event": "User signed up",
              "text": "user@example.com",
              "emoji": "👤",
              "properties": {
                "user_id": 42,
                "email_address": "user@example.com"
              },
              "occurred_at": "'$(date -u +"%Y-%m-%dT%H:%M:%SZ")'",
              "idempotency_key": "user-signed-up:42"
            }'
        CURL
      %>

      <div class="form-field">
        <%= label_tag :curl, "curl", class: "form-field__label" %>

        <%= text_area_tag(
          :curl,
          curl_command,
          readonly: true,
          class: "text-field text-sm code-field resize-none",
          rows: 14,
          onclick: "this.select()"
        ) %>
      </div>

      <%= button_to_copy_to_clipboard(curl_command) { "copy curl" } %>
    </div>
  <% end %>
</div>
