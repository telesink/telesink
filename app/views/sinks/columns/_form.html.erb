<div class="column__header">
  <h2 class="column__title">
    edit column "<%= column.name %>"
  </h2>

  <%= link_to(
    "close",
    sink_column_path(column.sink, column),
    data: { turbo_frame: dom_id(column) },
    class: "link"
  ) %>
</div>

<div class="column-data">
  <%= form_with(model: [sink, column], class: "form") do |form| %>
    <div class="form-field">
      <%= form.label :name, "name", class: "form-field__label" %>
      <%= form.text_field :name, autofocus: true, class: "text-field" %>
    </div>

    <%= render "shared/banners" %>

    <div>
      <%= form.button "save", type: :submit, class: "btn btn--primary" %>
    </div>
  <% end %>

  <hr class="divider">

  <details>
    <summary class="link">more</summary>
    <%= button_to(
      "delete column",
      [sink, column],
      method: :delete,
      data: {
        turbo_frame: "_top",
        turbo_confirm: "delete the '#{column.name}' column? events in this column will not be deleted."
      },
      class: "btn btn--danger"
    ) %>
  </details>
</div>
