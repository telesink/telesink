<div class="column__header">
  <h2 class="column__title">
    edit column "<%= column.name %>"
  </h2>

  <%= link_to(
    "close",
    sink_column_path(column.sink, column),
    data: { turbo_frame: dom_id(column) },
    class: "link"
  ) %>
</div>

<div class="column-data">
  <%= form_with(
    model: [sink, column],
    namespace: dom_id(column),
    class: "form"
  ) do |form| %>
    <div class="form-field">
      <%= form.label :name, "name", class: "form-field__label" %>
      <%= form.text_field :name, autofocus: true, class: "text-field" %>
    </div>

    <div class="form-field">
      <%= form.label :event_types, "filter by event", class: "form-field__label" %>
      <%= form.select(
        :event_types,
        options_for_select(@available_event_types.map { |t| [t.humanize, t] }, column.event_types),
        {
          include_blank: "(show all events)"
        },
        {
          multiple: true,
          size: 8,
          class: "text-field"
        }
      ) %>
      <small class="form-field__help">hold ctrl/cmd to select multiple events</small>
    </div>

    <div class="form-field">
      <%= form.label :search, "filter by text", class: "form-field__label" %>
      <%= form.search_field(
        :search,
        value: column.search_term,
        class: "text-field"
      ) %>
      <small class="form-field__help">case-insensitive, can be empty</small>
    </div>

    <%= render "shared/banners" %>

    <div>
      <%= form.button "save column", type: :submit, class: "btn btn--primary" %>
    </div>
  <% end %>

  <hr class="divider">

  <details>
    <summary class="link">more</summary>
    <%= button_to(
      "delete column",
      [sink, column],
      method: :delete,
      data: {
        turbo_frame: "_top",
        turbo_confirm: "delete the '#{column.name}' column? events in this column will not be deleted."
      },
      class: "btn btn--danger"
    ) %>
  </details>
</div>
