<li
  id="<%= dom_id(folder, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--current" => is_current,
    "sidebar-list__item--has-new-events" => has_new_events
  )
  %>"
>
  <span class="sidebar-list__name">
    <%= link_to_unless_current "#{folder.name}/", folder_path(folder), class: "link" %>
  </span>
</li>
