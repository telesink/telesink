<div class="column__header">
  <h1 class="column__title">
    <span class="truncate">edit what?</span>
  </h1>

  <%= link_to root_path, class: "link link--subtle", title: "close" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
      <path fill-rule="evenodd" d="M12.5 9.75A2.75 2.75 0 0 0 9.75 7H4.56l2.22 2.22a.75.75 0 1 1-1.06 1.06l-3.5-3.5a.75.75 0 0 1 0-1.06l3.5-3.5a.75.75 0 0 1 1.06 1.06L4.56 5.5h5.19a4.25 4.25 0 0 1 0 8.5h-1a.75.75 0 0 1 0-1.5h1a2.75 2.75 0 0 0 2.75-2.75Z" clip-rule="evenodd"></path>
    </svg>
  <% end %>
</div>

<ul class="list sidebar-list sidebar-list--striped">
  <% @sink_memberships.each do |membership| %>
    <%= render(
      "sinks/editable_sink",
      sink: membership.sink,
      current_sink_id: Current.user.current_sink_id,
      membership: membership,
    ) %>
  <% end %>
</ul>
