<%= turbo_frame_tag :sinks do %>
  <div class="column-data sidebar-account">
    <p class="column-data__text">
      <span class="font-bold">sinks</span>
    </p>
  </div>

  <% if @sink_memberships.any? %>
    <ul class="sidebar-list">
      <% @sink_memberships.each do |membership| %>
        <%= render(
          "sinks/sink",
          sink: membership.sink,
          current_sink_id: Current.user.current_sink_id,
          membership: membership
        ) %>
      <% end %>
    </ul>
  <% else %>
    <div class="column-data">
      <p class="column-data__text italic">no sinks yet</p>
    </div>
  <% end %>

  <div class="column-data">
    <p class="column-data__text">
      <%= link_to(
        new_sink_path,
        data: { turbo_frame: :sinks },
        class: "btn btn--#{@sink_memberships.any? ? 'secondary' : 'primary'}"
      ) do %>
        new sink
      <% end %>
    </p>
  </div>
<% end %>
