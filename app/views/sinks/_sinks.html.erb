<%
  can_administer = Current.user.can_administer?
  has_content = @sink_memberships.any?
%>

<div class="column__header">
  <h1 class="column__title">
    <span class="truncate">sinks</span>
  </h1>

  <% if can_administer %>
    <span class="sink-actions">
      <% if Current.sink %>
        <%= link_to edit_sink_path(Current.sink), title: "edit", class: "link link--subtle" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
            <path d="M13.488 2.513a1.75 1.75 0 0 0-2.475 0L6.75 6.774a2.75 2.75 0 0 0-.596.892l-.848 2.047a.75.75 0 0 0 .98.98l2.047-.848a2.75 2.75 0 0 0 .892-.596l4.261-4.262a1.75 1.75 0 0 0 0-2.474Z" />
            <path d="M4.75 3.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h6.5c.69 0 1.25-.56 1.25-1.25V9A.75.75 0 0 1 14 9v2.25A2.75 2.75 0 0 1 11.25 14h-6.5A2.75 2.75 0 0 1 2 11.25v-6.5A2.75 2.75 0 0 1 4.75 2H7a.75.75 0 0 1 0 1.5H4.75Z" />
          </svg>
        <% end %>
      <% end %>

      <%= link_to new_sink_path, data: { turbo_frame: :sinks }, title: "create", class: "link link--subtle" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
          <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm.75-10.25v2.5h2.5a.75.75 0 0 1 0 1.5h-2.5v2.5a.75.75 0 0 1-1.5 0v-2.5h-2.5a.75.75 0 0 1 0-1.5h2.5v-2.5a.75.75 0 0 1 1.5 0Z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </span>
  <% end %>
</div>

<% if has_content %>
  <ul class="list sidebar-list sidebar-list--striped">
    <% @sink_memberships.each do |membership| %>
      <%= render(
        "sinks/sink",
        sink: membership.sink,
        current_sink_id: Current.user.current_sink_id,
        membership: membership,
        can_administer: can_administer,
        highlight_current_sink: @highlight_current_sink.nil? ? true : @highlight_current_sink
      ) %>
    <% end %>
  </ul>
<% else %>
  <div class="column-data">
    <p class="column-data__text italic">no sinks yet</p>
  </div>
<% end %>
