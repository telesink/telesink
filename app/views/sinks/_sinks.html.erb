<%
  can_administer = Current.user.can_administer?
  has_content = Current.account.folders.any? || @sink_memberships.any?
  memberships_by_folder = @sink_memberships.group_by { |m| m.sink.folder_id }
%>

<div class="column__header">
  <h1 class="column__title">
    <span class="truncate">sinks</span>
  </h1>

  <% if can_administer %>
    <span>
      <% if Current.user.current_sink_id %>
        <%= link_to "edit", edit_sink_path(Current.user.current_sink_id), class: "link" %>
      <% end %>
      <%= link_to "create", new_sink_path, data: { turbo_frame: :sinks }, class: "link" %>
    </span>
  <% end %>
</div>

<% if has_content %>
  <ul class="list sidebar-list sidebar-list--striped">
    <% Current.account.folders.ordered.each do |folder| %>
      <% folder_memberships = memberships_by_folder[folder.id] || [] %>

      <li class="sidebar-list__item">
        <span class="sidebar-list__name">
          <%= folder.name %>/
        </span>
      </li>

      <% folder_memberships.each do |membership| %>
        <%= render(
          "sinks/sink",
          sink: membership.sink,
          current_sink_id: Current.user.current_sink_id,
          membership: membership,
          can_administer: can_administer,
          nesting_prefix: membership.nesting_prefix
        ) %>
      <% end %>
    <% end %>

    <% ungrouped = memberships_by_folder[nil] || [] %>
    <% ungrouped.each do |membership| %>
      <%= render(
        "sinks/sink",
        sink: membership.sink,
        current_sink_id: Current.user.current_sink_id,
        membership: membership,
        can_administer: can_administer,
        nesting_prefix: membership.nesting_prefix
      ) %>
    <% end %>
  </ul>
<% else %>
  <div class="column-data">
    <p class="column-data__text italic">no sinks yet</p>
  </div>
<% end %>
