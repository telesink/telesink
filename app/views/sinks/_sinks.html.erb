<% can_administer = Current.user.can_administer? %>

<div class="column__header">
  <h1 class="column__title">
    <span class="truncate">sinks</span>
  </h1>

  <% if can_administer %>
    <span>
      <%= link_to "+folder", new_folder_path, data: { turbo_frame: :sinks }, class: "link" %>
      <%= link_to "+sink",   new_sink_path,  data: { turbo_frame: :sinks }, class: "link" %>
    </span>
  <% end %>
</div>

<ul class="list sidebar-list">
  <% if Current.account.folders.any? %>
    <% memberships_by_folder = @sink_memberships.group_by { |m| m.sink.folder_id } %>

    <% Current.account.folders.ordered.each do |folder| %>
      <% folder_memberships = memberships_by_folder[folder.id] || [] %>
      <% next if folder_memberships.empty? %>

      <li class="sidebar-list__item">
        <%= folder.name %>/

        <% current_in_this_folder = folder_memberships.any? { |m| m.sink_id == Current.user.current_sink_id } %>
        <% show_edit_link = can_administer && (folder.sinks.empty? || current_in_this_folder) %>

        <% if show_edit_link %>
          <%= link_to(
            "edit", edit_folder_path(folder),
            data: { turbo_frame: :sinks },
            class: "link link--subtle whitespace-nowrap"
          ) %>
        <% end %>
      </li>

      <% folder_memberships.each do |membership| %>
        <%= render(
          "sinks/sink",
          sink: membership.sink,
          current_sink_id: Current.user.current_sink_id,
          membership: membership,
          can_administer: can_administer,
          nesting_prefix: membership.nesting_prefix
        ) %>
      <% end %>
    <% end %>

    <% ungrouped = memberships_by_folder[nil] || [] %>
    <% ungrouped.each do |membership| %>
      <%= render(
        "sinks/sink",
        sink: membership.sink,
        current_sink_id: Current.user.current_sink_id,
        membership: membership,
        can_administer: can_administer,
        nesting_prefix: membership.nesting_prefix
      ) %>
    <% end %>

  <% else %>
    <% @sink_memberships.each do |membership| %>
      <%= render(
        "sinks/sink",
        sink: membership.sink,
        current_sink_id: Current.user.current_sink_id,
        membership: membership,
        can_administer: can_administer,
        nesting_prefix: membership.nesting_prefix
      ) %>
    <% end %>
  <% end %>
</ul>
