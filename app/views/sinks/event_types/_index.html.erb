<%= turbo_frame_tag "event_types" do %>
  <div class="column">
    <div class="column__header">
      <h1 class="column__title">event types in this sink</h1>
    </div>

    <div class="column-data">
      <% if @event_types&.any? %>
        <ul class="list">
          <% @event_types.each do |event_type| %>
            <li>
              <%= link_to(
                event_type_label(event_type),
                sink_event_type_path(sink, event_type),
                data: { turbo_frame: "event_types" },
                class: "link"
              ) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="column-data__text italic">no events yet</p>
      <% end %>
    </div>
  </div>
<% end %>
