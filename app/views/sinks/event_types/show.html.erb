<%= turbo_frame_tag "event_types" do %>
  <div class="column">
    <div class="column__header">
      <h2 class="column__title">event "<%= @event_type %>"</h2>

      <%= link_to(
        edit_sink_path(@sink),
        data: { turbo_frame: "event_types" },
        class: "link link--subtle",
        title: "close",
      ) do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="icon">
          <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
        </svg>
      <% end %>
    </div>

    <div class="column-data">
      <%= button_to(
        "delete this event",
        sink_event_type_path(@sink, @event_type),
        method: :delete,
        data: { turbo_confirm: "delete all events of type #{@event_type}?" },
        class: "btn btn--danger"
      ) %>
    </div>
  </div>
<% end %>
