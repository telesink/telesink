<li id="<%= dom_id(sink, :list_item) %>" class="sidebar-list__item <%= 'sidebar-list__item--current' if @sink == sink %>">
  <% if @sink == sink %>
    <%= sink.name %>
  <% else %>
    <%= link_to(
      sink.name,
      sink_path(sink),
      title: sink.name,
      class: "link truncate",
      data: { turbo_frame: "_top" },
    ) %>
  <% end %>

  <% if @sink == sink %>
    <%= link_to(
      "edit",
      edit_sink_path(sink),
      class: "link link--subtle",
      data: { turbo_frame: :sinks },
    ) %>
  <% end %>
</li>
