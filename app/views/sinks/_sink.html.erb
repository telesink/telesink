<% is_current = current_sink_id == sink.id %>

<li
  id="<%= dom_id(sink, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--current" => is_current,
    "sidebar-list__item--has-new-events" => membership.has_unread_events && !is_current,
  ) %>"
>
  <span class="sidebar-list__name">
    <%= nesting_prefix -%><% if is_current %><%= sink.name %><% else %><%= link_to(
      sink.name,
      sink_path(sink),
      title: sink.name,
      class: "link",
      data: { turbo_frame: "_top" }
    ) %><% end %>
  </span>

  <% if is_current && can_administer %>
    <%= link_to(
      "edit",
      edit_sink_path(sink),
      class: "link link--subtle sidebar-list__action",
      data: { turbo_frame: :sinks },
    ) %>
  <% end %>
</li>
