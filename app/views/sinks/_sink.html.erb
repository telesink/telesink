<%
  highlight_current_sink = local_assigns[:highlight_current_sink].nil? ? true : local_assigns[:highlight_current_sink]
  is_current = highlight_current_sink && current_sink_id == sink.id
  unread_count = membership.unread_count.to_i
  unread_count = 1 if unread_count.zero? && membership.has_unread_events?
%>

<li
  id="<%= dom_id(sink, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--linkable",
    "sidebar-list__item--in-folder" => local_assigns[:in_folder],
    "sidebar-list__item--current" => is_current,
    "sidebar-list__item--has-new-events" => unread_count.positive? && !is_current,
  ) %>"
>
  <% if is_current %>
    <span class="sidebar-list__row-current">
      <span class="sidebar-list__prefix">#</span>
      <span class="sidebar-list__name"><%= sink.name %></span>
    </span>
  <% else %>
    <%= link_to(
      sink_path(sink),
      title: sink.name,
      class: "sidebar-list__row-link link",
      data: {
        turbo_frame: :main_content,
        turbo_action: "advance",
        turbo_prefetch: false,
        sink_sidebar_link: true
      }
    ) do %>
      <span class="sidebar-list__prefix">#</span>
      <span class="sidebar-list__name"><%= sink.name %></span>

      <% if unread_count.positive? %>
        <span class="sidebar-list__unread"><%= unread_count %></span>
      <% end %>
    <% end %>
  <% end %>
</li>
