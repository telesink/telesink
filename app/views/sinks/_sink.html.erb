<% is_current = local_assigns[:highlight_current_sink] && current_sink_id == sink.id %>

<li
  id="<%= dom_id(sink, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--current" => is_current,
    "sidebar-list__item--in-folder" => sink.folder_id?,
    "sidebar-list__item--has-new-events" => membership.has_unread_events && !is_current,
  ) %>"
>
  <span class="sidebar-list__name">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="sidebar-list__icon">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
    </svg>

    <% if is_current %><%= sink.name %><% else %><%= link_to(
      sink.name,
      sink_path(sink),
      title: sink.name,
      class: "link",
      data: { turbo_frame: "_top" }
    ) %><% end %>
  </span>
</li>
