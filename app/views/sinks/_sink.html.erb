<%
  highlight_current_sink = local_assigns[:highlight_current_sink].nil? ? true : local_assigns[:highlight_current_sink]
  is_current = highlight_current_sink && current_sink_id == sink.id
  unread_count = membership.unread_count.to_i
%>

<li
  id="<%= dom_id(sink, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--current" => is_current,
    "sidebar-list__item--has-new-events" => unread_count.positive? && !is_current,
  ) %>"
>
  <span class="sidebar-list__prefix">#</span>

  <span class="sidebar-list__name">
    <% if is_current %><%= sink.name %><% else %><%= link_to(
      sink.name,
      sink_path(sink),
      title: sink.name,
      class: "link",
      data: { turbo_frame: "_top" }
    ) %><% end %>
  </span>

  <% if unread_count.positive? && !is_current %>
    <span class="sidebar-list__unread"><%= unread_count %></span>
  <% end %>
</li>
