<% is_current = local_assigns[:highlight_current_sink] && current_sink_id == sink.id %>

<li
  id="<%= dom_id(sink, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--current" => is_current,
    "sidebar-list__item--has-new-events" => membership.has_unread_events && !is_current,
  ) %>"
>
  <span class="sidebar-list__name">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="sidebar-list__icon">
      <path d="M14 2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2.172a2 2 0 0 0 .586 1.414l2.828 2.828A2 2 0 0 1 6 9.828v4.363a.5.5 0 0 0 .724.447l2.17-1.085A2 2 0 0 0 10 11.763V9.829a2 2 0 0 1 .586-1.414l2.828-2.828A2 2 0 0 0 14 4.172V2Z" />
    </svg>

    <% if is_current %><%= sink.name %><% else %><%= link_to(
      sink.name,
      sink_path(sink),
      title: sink.name,
      class: "link",
      data: { turbo_frame: "_top" }
    ) %><% end %>
  </span>
</li>
