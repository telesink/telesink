<%= turbo_stream_from @sink %>

<% @sink.columns.order(:position).each do |column| %>
  <%= render(
    partial: column.has_events? ? "sinks/columns/column" : "sinks/columns/config_column",
    locals: { column: column }
  ) %>
<% end %>

<div class="add-column-column">
  <%= button_to(
    "add column",
    sink_columns_path(@sink),
    method: :post,
    data: { turbo: false },
    class: "btn btn--secondary btn--before-content whitespace-nowrap"
  ) %>
</div>
