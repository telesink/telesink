<% if @sink.events.exists? %>
  <%= render(
    partial: "sinks/columns/column",
    collection: @sink.columns,
    locals: {
      events: @events,
    }
  ) %>

  <div class="add-column-column">
    <%= button_to(
      "add column",
      sink_columns_path(@sink),
      method: :post,
      data: { turbo: false },
      class: "btn btn--secondary btn--before-content whitespace-nowrap"
    ) %>
  </div>
<% else %>
  <%= render partial: "sinks/columns/config_column" %>
<% end %>
