<% content_for(:title, @sink.name) %>

<%= turbo_stream_from @sink %>

<div
  id="columns-container"
  data-controller="sortable-columns"
  data-sortable-columns-url-value="<%= sink_column_order_path(@sink) %>"
>
  <div id="columns" class="columns">
    <% @sink.columns.each do |column| %>
      <%= render(
        partial: column.has_events? ? "sinks/columns/column" : "sinks/columns/config_column",
        locals: {
          column: column,
          membership: @membership,
          seen_cutoffs: @seen_cutoffs
        }
      ) %>
    <% end %>
  </div>

  <div id="add-column-column" class="add-column-column">
    <% if Current.user.can_administer? %>
      <%= button_to(
        "add column",
        sink_columns_path(@sink),
        method: :post,
        class: "btn btn--secondary btn--before-content whitespace-nowrap"
      ) %>
    <% end %>
  </div>
</div>
