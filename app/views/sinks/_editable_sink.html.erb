<%
  is_current = current_page?(edit_sink_path(sink))
%>

<li
  id="<%= dom_id(sink, "list_item") %>"
  class="<%= class_names(
    "sidebar-list__item",
    "sidebar-list__item--linkable",
    "sidebar-list__item--in-folder" => local_assigns[:in_folder],
    "sidebar-list__item--current" => is_current,
  ) %>"
>
  <% if is_current %>
    <span class="sidebar-list__row-current">
      <span class="sidebar-list__prefix">#</span>
      <span class="sidebar-list__name"><%= sink.name %></span>
    </span>
  <% else %>
    <%= link_to(
      edit_sink_path(sink),
      title: sink.name,
      class: "sidebar-list__row-link link",
      data: { turbo_frame: "_top", turbo_prefetch: false },
    ) do %>
      <span class="sidebar-list__prefix">#</span>
      <span class="sidebar-list__name"><%= sink.name %></span>
    <% end %>
  <% end %>
</li>
