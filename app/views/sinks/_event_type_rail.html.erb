<aside class="filter-rail">
  <div class="filter-rail__header">
    <h2 class="filter-rail__title">filters</h2>
  </div>

  <%= render(
    "sinks/event_filters",
    sink: sink,
    event_type_counts: event_type_counts,
    current_event_type: current_event_type,
    event_date: event_date,
    property_key: local_assigns[:property_key],
    property_op: local_assigns[:property_op],
    property_value: local_assigns[:property_value],
    variant: "desktop"
  ) %>

  <%= render(
    "sinks/event_calendar",
    sink: sink,
    calendar_month: calendar_month,
    event_dates: event_dates,
    current_event_type: current_event_type,
    selected_date: event_date,
    property_key: local_assigns[:property_key],
    property_op: local_assigns[:property_op],
    property_value: local_assigns[:property_value]
  ) %>
</aside>
