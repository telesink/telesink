<%
  title = "update your password"
  content_for(:title, title)
%>

<div class="column">
  <h1 class="column__header"><%= title %></h1>

  <div class="column-data">
    <%= form_with url: password_path(params[:token]), method: :put, class: "mt-1ch form" do |form| %>
      <div class="form-field">
        <%= form.label :password, "new password", class: "form-field__label" %>
        <%= form.password_field(
          :password,
          required: true,
          autocomplete: "new-password",
          maxlength: 72,
          class: "text-field",
        ) %>
      </div>

      <div class="form-field">
        <%= form.label :password, "confirmation password", class: "form-field__label" %>
        <%= form.password_field(
          :password_confirmation,
          required: true,
          autocomplete: "new-password",
          maxlength: 72,
          class: "text-field",
        ) %>
      </div>

      <%= render "shared/banners" %>

      <div>
        <%= form.button "save new password", type: :submit, class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</div>
