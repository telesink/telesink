<%
  title = "forgot your password?"
  content_for(:title, title)
%>
<header>
  <a href="/" class="logo link">
    <%= inline_svg_tag "logo.svg" %>
    telesink
  </a>
</header>

<h1 class="page-title"><%= title %></h1>


<%= form_with url: passwords_path, class: "form max-w-sm" do |form| %>
  <div class="form-field">
    <%= form.label :email_address, "email", class: "form-field__label" %>
    <%= form.email_field(
      :email_address,
      required: true,
      autofocus: true,
      autocomplete: "username",
      value: params[:email_address],
      class: "text-field",
    ) %>
  </div>

  <%= render "shared/banners" %>

  <div>
    <%= form.button "email reset instructions", type: :submit, class: "btn btn--primary" %>
  </div>

  <div>
    <%= link_to "sign in", new_session_path, class: "link" %>
    |
    <%= link_to "sign up", new_registration_path, class: "link" %>
  </div>
<% end %>

