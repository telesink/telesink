<%
  title = "forgot your password?"
  content_for(:title, title)
%>

<div class="column">
  <div class="column__header">
    <h1 class="column__title"><%= title %></h1>
  </div>

  <div class="column-data">
    <%= form_with url: passwords_path, class: "mt-1ch form" do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "email", class: "form-field__label" %>
        <%= form.email_field(
          :email_address,
          required: true,
          autofocus: true,
          autocomplete: "username",
          value: params[:email_address],
          class: "text-field",
        ) %>
      </div>

      <%= render "shared/banners" %>

      <div>
        <%= form.button "email reset instructions", type: :submit, class: "btn btn--primary" %>
      </div>

      <div>
        <%= link_to "sign in", new_session_path, class: "link" %>
        &middot;
        <%= link_to "sign up", new_registration_path, class: "link" %>
      </div>
    <% end %>
  </div>
</div>
