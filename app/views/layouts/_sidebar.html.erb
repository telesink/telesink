<aside class="column sidebar">
  <%= turbo_stream_from "user_#{Current.user.id}_sinks" %>

  <div class="sidebar-account">
    <span class="truncate">@<%= Current.user.nickname %></span>

    <%= button_to(
      "sign out",
      session_path,
      method: :delete,
      data: { turbo_confirm: "sign out?" },
      class: "link link--subtle whitespace-nowrap text-base",
    ) %>
  </div>

  <%= turbo_frame_tag :sinks do %>
    <%= render "sinks/sinks" %>
  <% end %>
</aside>
