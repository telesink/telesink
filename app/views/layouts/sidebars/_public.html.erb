<header class="column column--narrow">
  <div class="column-data">
    <%= link_to root_path, class: "logo link" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" width="16" height="16">
        <path fill="#0064e6" d="M0 0h20v20H0z"></path>
        <path fill="#fff" d="M6.76 3.16H9V16.8H6.76zM10.961 3.16h2.24V16.8h-2.24zM15.16 3.16h2.24V16.8h-2.24zM2.561 3.16h2.24V16.8h-2.24z"></path>
      </svg>
      telesink
    <% end %>
    <p class="column-data__text">
      Know what your product is doing. <i>Right now</i>.
    </p>
  </div>

  <div class="divider"></div>

  <div class="column-data">
    <p class="column-data__text">
      <a href="https://github.com/telesink/telesink" target="_blank" class="link">source code</a> (AGPL)
    </p>
  </div>

  <div class="divider"></div>

  <div class="column-data">
    <p class="column-data__text">
      <a href="https://x.com/TelesinkHQ" target="_blank" class="link">𝕏</a>
      &middot;
      <a href="http://bsky.app/profile/telesink.com" target="_blank" class="link">bluesky</a>
    </p>
  </div>

  <div class="divider"></div>

  <div class="column-data">
    <p class="column-data__text">
      <a href="https://telesink.com/terms" target="_blank" class="link">terms of service</a>
      <br>
      <a href="https://telesink.com/privacy" target="_blank" class="link">privacy policy</a>
    </p>
  </div>

  <div class="divider"></div>

  <div class="column-data">
    <p class="column-data__text text-xs">
      We are here to make real-time event tracking better. We will be honest,
      transparent, and empathetic. We care for our users, and we will not exploit
      them, and we hope that they will reward our care and diligence with success.
    </p>
  </div>

  <div class="column-data">
    <p class="mt-1ch column-data__text text-xs">
      © <%= Time.current.year %>
      <a href="https://kyrylo.org" target="_blank" class="link">Kyrylo Silin</a>
      PE
    </p>
  </div>
</header>

