<aside class="column sidebar sidebar--sinks">
  <%= turbo_stream_from "user_#{Current.user.id}_sinks" %>

  <details class="sidebar__drawer">
    <summary class="sidebar__drawer-summary">
      <span class="sidebar__drawer-label">channels</span>
    </summary>

    <div id="sinks" class="sidebar__content" data-controller="sink-sidebar">
      <%= render "sinks/sinks" %>
    </div>

    <%= render "layouts/sidebars/account" %>
  </details>
</aside>
