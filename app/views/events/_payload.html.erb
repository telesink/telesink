<div class="event-properties">
  <h3 class="event-properties__title">properties</h3>
  <dl class="event-properties__list">
    <% payload.each do |key, value| %>
      <div class="event-properties__item">
        <dt class="event-properties__item-key">
          <%= key %>
        </dt>
        <dd class="event-properties__item-value">
          <%= value || "<null>" %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
