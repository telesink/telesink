<% event_time = @event.occurred_at.in_time_zone %>

<%= turbo_frame_tag dom_id(@event, :detail) do %>
  <div class="event-detail">
    <div class="event-detail__meta">
      <time datetime="<%= @event.occurred_at.iso8601 %>" title="<%= @event.occurred_at.iso8601 %>">
        <%= event_time.strftime("%Y-%m-%d %H:%M:%S %Z") %>
      </time>

      <%= link_to(
        "##{@event.id}",
        event_path(@event),
        data: { turbo_frame: "_top" },
        class: "event-detail__permalink link link--subtle",
        title: "permalink"
      ) %>
    </div>

    <% if @event.properties.present? %>
      <%= render "events/properties", properties: @event.properties %>
    <% else %>
      <p class="event-properties__empty">no properties</p>
    <% end %>
  </div>
<% end %>
