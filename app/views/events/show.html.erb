<%= turbo_frame_tag dom_id(@column) do %>
  <div class="column__header column__header--cast-shadow">
    <h2 class="column__title">
      <span><%= @event.emoji %></span>
      <span><%= @event.event_type %></span>
    </h2>

    <%= link_to(
      "close",
      sink_column_path(@column.sink, @column),
      data: { turbo_frame: dom_id(@column) },
      class: "link"
    ) %>
  </div>

  <div class="event-detail">
    <div class="event-detail__meta">
      <time datetime="<%= @event.occurred_at.iso8601 %>">
        <%= @event.occurred_at.strftime("%b %d, %Y at %I:%M %p") %>
      </time>

      #<%= @event.id %>
    </div>

    <p class="event-detail__body">
      <%= @event.text %>
    </p>

    <% if @event.properties.present? %>
      <div class="event-detail__properties">
        <%= render "events/properties", properties: @event.properties %>
      </div>
    <% end %>
  </div>
<% end %>
