<%= link_to(
  event_path(event, column_id: column.id),
  data: { turbo_frame: dom_id(column) },
  class: "event-preview-card",
  title: event.text,
) do %>

  <div class="event-preview <%= 'event-preview--new-event' if local_assigns[:new_event] %>">
    <% if event.emoji.present? %>
      <div class="event-preview__emoji"><%= event.emoji %></div>
    <% end %>

    <div class="event-preview__content">
      <div class="event-preview__header">
        <strong class="event-preview__title"><%= event.event_type.humanize %></strong>
        <time
          data-controller="time-formatter"
          class="event-preview__time"
          datetime="<%= event.occurred_at.iso8601 %>"
          title="<%= event.occurred_at.iso8601 %>"
        >
        </time>
      </div>

      <div class="event-preview__body">
        <%= highlighted_event_body(event, column) %>
      </div>
    </div>
  </div>

<% end %>
